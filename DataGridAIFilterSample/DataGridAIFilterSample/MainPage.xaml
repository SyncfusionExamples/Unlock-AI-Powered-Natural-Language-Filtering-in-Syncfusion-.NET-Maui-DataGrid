<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:input="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="DataGridAIFilterSample.MainPage">

    <Grid RowDefinitions="Auto, Auto, *" Padding="10">
        <Grid.Resources>
            <Style x:Key="HeaderBoldStyle" TargetType="sfgrid:DataGridHeaderCell">
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>
        </Grid.Resources>

        <Grid Grid.Row="0"
          ColumnDefinitions="*, Auto, Auto"
          ColumnSpacing="10"
          IsVisible="{OnPlatform Android=False, iOS=False, MacCatalyst=True, WinUI=True}">
            <input:SfComboBox
                          ItemsSource="{Binding PromptSuggestions}"
                          SelectedItem="{Binding SelectedSuggestion}"
                          Text="{Binding Prompt, Mode=TwoWay}"
                          IsEditable="True"
                          Placeholder="Ask AI to apply filter to SfDataGrid"
                          MaxDropDownHeight="260"
                          HeightRequest="40" />
            <Button Grid.Column="1" Text="Execute Prompt"
                Command="{Binding ExecutePromptCommand}" />
            <Button Grid.Column="2" Text="Reset"
                Command="{Binding ResetCommand}" />
        </Grid>

        <Grid Grid.Row="0"
          RowDefinitions="Auto, Auto"
          ColumnDefinitions="*, *"
          RowSpacing="10" ColumnSpacing="10"
          IsVisible="{OnPlatform Android=True, iOS=True, MacCatalyst=False, WinUI=False}">
            <input:SfComboBox Grid.Row="0" Grid.ColumnSpan="2"
                          ItemsSource="{Binding PromptSuggestions}"
                          SelectedItem="{Binding SelectedSuggestion}"
                          Text="{Binding Prompt, Mode=TwoWay}"
                          IsEditable="True"
                          Placeholder="Ask AI to apply filter to SfDataGrid"
                          MaxDropDownHeight="260"
                          HeightRequest="40" />
            <Button Grid.Row="1" Grid.Column="0" Text="Execute Prompt"
                Command="{Binding ExecutePromptCommand}" />
            <Button Grid.Row="1" Grid.Column="1" Text="Reset"
                Command="{Binding ResetCommand}" />
        </Grid>

        <sfgrid:SfDataGrid x:Name="DataGrid"
                           Grid.Row="2" RowHeight="50"
                           VerticalScrollBarVisibility="Never"
                           GridLinesVisibility="Both"
                           ColumnWidthMode="Auto"
                           HeaderGridLinesVisibility="Both"
                           ItemsSource="{Binding Employees}"
                           SortingMode="Multiple">
            <sfgrid:SfDataGrid.Columns>
                <sfgrid:DataGridNumericColumn MappingName="EmployeeId" HeaderText="ID" HeaderTextAlignment="Center"
                                              CellTextAlignment="Center" Format="0"
                                              HeaderStyle="{StaticResource HeaderBoldStyle}"/>
                <sfgrid:DataGridTextColumn MappingName="Name"
                                           HeaderStyle="{StaticResource HeaderBoldStyle}" HeaderTextAlignment="Center"
                                           CellTextAlignment="Center" />
                <sfgrid:DataGridTextColumn MappingName="Title"
                                           HeaderStyle="{StaticResource HeaderBoldStyle}" HeaderTextAlignment="Center"
                                           CellTextAlignment="Center" />
                <sfgrid:DataGridNumericColumn MappingName="Rating" Format="N0"
                                              HeaderStyle="{StaticResource HeaderBoldStyle}" HeaderTextAlignment="Center"
                                              CellTextAlignment="Center"/>
                <sfgrid:DataGridDateColumn MappingName="BirthDate" Format="d"
                                           HeaderStyle="{StaticResource HeaderBoldStyle}" HeaderTextAlignment="Center"
                                           CellTextAlignment="Center"/>
                <sfgrid:DataGridTextColumn MappingName="Gender"
                                           HeaderStyle="{StaticResource HeaderBoldStyle}" HeaderTextAlignment="Center"
                                           CellTextAlignment="Center" />
                <sfgrid:DataGridNumericColumn MappingName="Salary"  HeaderTextAlignment="Center"
                                              CellTextAlignment="Center" Format="N0"
                                              HeaderStyle="{StaticResource HeaderBoldStyle}" />
            </sfgrid:SfDataGrid.Columns>
        </sfgrid:SfDataGrid>
    </Grid>
</ContentPage>
